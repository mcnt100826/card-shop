<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>订单管理后台</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui;}
body{background:#f3f4f6;padding:20px;}
h1{text-align:center;margin-bottom:24px;}
table{
  width:100%;
  border-collapse:collapse;
  background:#fff;
  border-radius:10px;
  overflow:hidden;
  box-shadow:0 2px 10px #00000015;
}
th,td{
  border:1px solid #eee;
  padding:12px;
  text-align:center;
}
th{background:#3b82f6;color:white;}
a.back{
  display:inline-block;
  margin:20px 0;
  color:#3b82f6;
}
.del-btn{
  background:red;color:white;border:none;padding:6px 10px;border-radius:4px;
}
</style>
</head>
<body>
<h1>订单管理列表</h1>
<a class="back" href="/">← 返回商品首页</a>

<table>
  <tr>
    <th>商品名称</th>
    <th>价格</th>
    <th>操作</th>
  </tr>
  <% orders.forEach((item,index)=>{ %>
  <tr>
    <td><%=item.goodsName%></td>
    <td><%=item.price%></td>
    <td>
      <form action="/del-order/<%=index%>" method="post" style="display:inline">
        <button class="del-btn" type="submit">删除订单</button>
      </form>
    </td>
  </tr>
  <% }) %>
</table>

<% if(orders.length === 0){ %>
  <p style="text-align:center;margin-top:20px">暂无订单</p>
<% } %>
</body>
</html>
