<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>订单管理后台</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui, sans-serif;}
body{
  background-color:#f0f4f8;
  padding:24px;
}
.container{
  max-width:900px;
  margin:0 auto;
}
h1{
  text-align:center;
  color:#1e293b;
  margin-bottom:24px;
}
.back-link{
  display:inline-block;
  margin-bottom:16px;
  color:#3b82f6;
  text-decoration:none;
  font-weight:500;
}
.back-link:hover{
  text-decoration:underline;
}
.card{
  background:#ffffff;
  border-radius:14px;
  box-shadow:0 4px 16px rgba(0,0,0,0.08);
  overflow:hidden;
}
table{
  width:100%;
  border-collapse: collapse;
}
th{
  background:#2563eb;
  color:white;
  padding:14px;
  text-align:center;
  font-weight:600;
}
td{
  padding:14px;
  text-align:center;
  border-bottom:1px solid #edf2f7;
  color:#334155;
}
tr:hover{
  background:#f8fafc;
}
.del-btn{
  background-color:#ef4444;
  color:#fff;
  border:none;
  padding:7px 12px;
  border-radius:6px;
  cursor:pointer;
}
.del-btn:hover{
  background:#dc2626;
}
.ok-btn{
  background-color:#22c55e;
  color:#fff;
  border:none;
  padding:7px 12px;
  border-radius:6px;
  cursor:pointer;
  margin-right:6px;
}
.ok-btn:hover{
  background:#16a34a;
}
.empty-tip{
  text-align:center;
  padding:40px;
  color:#64748b;
  font-size:16px;
}
.status-tag{
  display:inline-block;
  padding:4px 10px;
  border-radius:20px;
  font-size:14px;
}
.pending{
  background:#fef3c7;
  color:#d97706;
}
.success{
  background:#dcfce7;
  color:#15803d;
}
</style>
</head>
<body>
<div class="container">
  <h1>📋 订单管理后台</h1>
  <a class="back-link" href="/logout" style="float:right;">🚪退出登录</a>
  <a class="back-link" href="/">← 返回商品首页</a>

  <div class="card">
    <% if(orders.length === 0){ %>
      <div class="empty-tip">暂无订单，等待用户提交</div>
    <% }else{ %>
    <table>
      <thead>
        <tr>
          <th>商品名称</th>
          <th>商品价格</th>
          <th>订单状态</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach((item,index)=>{ %>
        <tr>
          <td><%=item.goodsName%></td>
          <td><%=item.price%></td>
          <td>
            <% if(item.status === "ok"){ %>
              <span class="status-tag success">✅ 已审核通过</span>
            <% }else{ %>
              <span class="status-tag pending">⏳ 待审核</span>
            <% } %>
          </td>
          <td>
            <% if(item.status !== "ok"){ %>
            <form action="/audit-order/<%=index%>" method="post" style="display:inline">
              <button class="ok-btn" type="submit">审核通过</button>
            </form>
            <% } %>
            <form action="/del-order/<%=index%>" method="post" style="display:inline">
              <button class="del-btn" type="submit">删除订单</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
</body>
</html>
