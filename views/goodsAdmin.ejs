<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>商品管理</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui, sans-serif;}
body{
  background-color:#f0f4f8;
  padding:24px;
}
.container{
  max-width:900px;
  margin:0 auto;
}
h1{
  text-align:center;
  color:#1e293b;
  margin-bottom:24px;
}
.back-link{
  display:inline-block;
  margin-bottom:16px;
  color:#3b82f6;
  text-decoration:none;
  font-weight:500;
}
.back-link:hover{
  text-decoration:underline;
}
.card{
  background:#ffffff;
  border-radius:14px;
  box-shadow:0 4px 16px rgba(0,0,0,0.08);
  padding:24px;
  margin-bottom:24px;
}
h3{margin-bottom:16px;color:#222;}
input{
  width:100%;
  padding:12px;
  border:1px solid #cbd5e1;
  border-radius:8px;
  font-size:16px;
  margin-bottom:12px;
}
.add-btn{
  width:100%;
  padding:12px;
  background:#22c55e;
  color:#fff;
  border:none;
  border-radius:8px;
  font-size:16px;
  cursor:pointer;
}
.add-btn:hover{background:#16a34a;}
table{
  width:100%;
  border-collapse: collapse;
}
th{
  background:#2563eb;
  color:white;
  padding:14px;
  text-align:center;
  font-weight:600;
}
td{
  padding:14px;
  text-align:center;
  border-bottom:1px solid #edf2f7;
  color:#334155;
}
tr:hover{
  background:#f8fafc;
}
.del-btn{
  background-color:#ef4444;
  color:#fff;
  border:none;
  padding:7px 12px;
  border-radius:6px;
  cursor:pointer;
}
.del-btn:hover{
  background:#dc2626;
}
.empty-tip{
  text-align:center;
  padding:30px;
  color:#64748b;
}
</style>
</head>
<body>
<div class="container">
  <h1>🛒 商品管理后台</h1>
  <a class="back-link" href="/order-admin">← 返回订单管理</a>

  <div class="card">
    <h3>➕ 添加新商品</h3>
    <form method="post" action="/add-goods">
      <label>商品名称</label>
      <input type="text" name="name" placeholder="例如：商品C" required>
      <label>商品价格</label>
      <input type="text" name="price" placeholder="例如：30元" required>
      <button class="add-btn" type="submit">添加商品</button>
    </form>
  </div>

  <div class="card">
    <h3>📦 当前商品列表</h3>
    <% if(goodsList.length ===0){ %>
      <div class="empty-tip">暂无商品，请添加</div>
    <% }else{ %>
    <table>
      <thead>
        <tr>
          <th>商品名称</th>
          <th>价格</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% goodsList.forEach((item,index)=>{ %>
        <tr>
          <td><%=item.name%></td>
          <td><%=item.price%></td>
          <td>
            <form action="/del-goods/<%=index%>" method="post" style="display:inline">
              <button class="del-btn">删除商品</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
</body>
</html>
