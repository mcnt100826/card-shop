<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>后台订单管理</title>
</head>
<body>
    <h2>订单列表</h2>
    <table border="1">
        <tr>
            <td>订单ID</td>
            <td>商品ID</td>
            <td>状态</td>
        </tr>
        <% orders.forEach(item=>{ %>
        <tr>
            <td><%=item.id%></td>
            <td><%=item.goodsId%></td>
            <td><%=item.status%></td>
        </tr>
        <% }) %>
    </table>
</body>
</html>
