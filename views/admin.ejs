<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>管理员登录</title>
<style>
body{background:#f3f4f6;padding:30px;font-family:system-ui;}
.login-box{
  max-width:400px;
  margin:50px auto;
  background:#fff;
  padding:30px;
  border-radius:12px;
  box-shadow:0 2px 10px #00000015;
}
h2{text-align:center;margin-bottom:25px;}
input{
  width:100%;
  padding:10px;
  margin:8px 0 16px;
  border:1px solid #ddd;
  border-radius:6px;
}
button{
  width:100%;
  background:#22c55e;
  color:white;
  border:none;
  padding:10px;
  border-radius:6px;
  font-size:16px;
}
</style>
</head>
<body>
<div class="login-box">
  <h2>管理员登录</h2>
  <form method="post">
    <label>账号</label>
    <input name="user" type="text">
    <label>密码</label>
    <input name="pwd" type="password">
    <button type="submit">登录</button>
  </form>
  <div style="text-align:center;margin-top:20px">
    <a href="/">返回首页</a>
  </div>
</div>
</body>
</html>
